formatter: markdown table

header-from: docs/.terraform-docs.header.md
footer-from: docs/.terraform-docs.footer.md

content: |-
{% raw %}  {{ .Header }}{% endraw %}

  <!-- markdownlint-disable no-inline-html -->

{%- if create_examples_dir %}
  ## Examples

  <!--
    INFORMATION: Add new examples in the `.terraform-docs.yml` file.
  -->

  ```hcl
{% raw %}  {{ include "examples/foo/main.tf" }}{% endraw %}
  ```
{% endif %}
{% raw %}  {{ .Requirements }}

  {{ .Providers }}

  {{ .Modules }}

  {{ .Resources }}

  {{ .Inputs }}

  {{ .Outputs }}

  {{ .Footer }}

output:
  file: README.md
  mode: replace
  template: |-
    <!--
      WARNING: DO NOT CHANGE THIS FILE MANUALLY.
      This file is auto-generated by terraform-docs, any changes made here will be overwritten.
    -->

    <!-- BEGIN_TF_DOCS -->
    {{ .Content }}
    <!-- END_TF_DOCS -->
    {{- printf "\n" -}}
{%- endraw %}
