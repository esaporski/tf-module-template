[tool.commitizen]
name = "cz_conventional_commits"
tag_format = "$version"
annotated_tag = true

version_scheme = "semver2"
version = "0.0.1"
version_files = []

# Commitizen will keep the major version at zero
# Useful during the initial development stage of your project
major_version_zero = true

bump_message = "chore(release): $current_version → $new_version [skip-ci]"
# Update changelog on bump is not working correctly
update_changelog_on_bump = false

{#- https://stackoverflow.com/a/71850812 #}
{%- set _terraform_docs_paths = [] %}
{%- set _ = _terraform_docs_paths.append("examples") if create_examples_dir %}
{%- set _ = _terraform_docs_paths.append("modules") if create_modules_dir %}

pre_bump_hooks = [{%- if _terraform_docs_paths | length == 0 %}]
{%- else %}
  {%- for _path in _terraform_docs_paths %}
  "terraform-docs --recursive=true --recursive-include-main=false --recursive-path={{ _path }} .",
  {%- endfor %}
{%- endif %}
{%- if _terraform_docs_paths | length > 0 %}
]
{%- endif %}
post_bump_hooks = []

changelog_file = "CHANGELOG.md"

# Provide extra variables to the changelog template
extras.repository_url = "{{ vcs_repository_url }}"

# Provide custom changelog jinja template path relative to the current working directory
template = "docs/.CHANGELOG.md.j2"
